rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupMembers(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    function isGroupMember(groupId) {
      return signedIn() && request.auth.uid in groupMembers(groupId);
    }

    // True when a write touches only the listed fields.
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Profiles are readable by any signed-in user (search, chat headers),
    // but writable ONLY by their owner. This is what stops one user from
    // editing another user's profile.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false;
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // The creator must include themselves in the member list.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in resource.data.members;
      // Direct chats: either party may delete. Groups: creator only.
      allow delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid
            || (resource.data.members.size() == 2 && request.auth.uid in resource.data.members));

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.senderId == request.auth.uid;
        // Members may only mark-as-read and react, never rewrite message content.
        allow update: if isGroupMember(groupId)
          && changedOnly(['readBy', 'reactions']);
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }

      match /typing/{uid} {
        allow read: if isGroupMember(groupId);
        allow write: if isSelf(uid) && isGroupMember(groupId);
      }
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending';
      // Only the recipient can accept a request.
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && changedOnly(['status']);
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
  }
}
